# ~/.config/themes/rose-pine/zsh.zsh

export HIGHLIGHT_STYLE="rose-pine"
export PYGMENTIZE_STYLE="rose-pine"
export BAT_THEME="rose-pine"

rose_foreground="#e0def4"
rose_muted="#6e6a86"
rose_subtle="#908caa"
rose_foam="#9ccfd8"
rose_pine="#31748f"
rose_gold="#f6c177"
rose_love="#eb6f92"
rose_iris="#c4a7e7"
rose_rose="#ebbcba"

ZSH_HIGHLIGHT_STYLES[default]="fg=$rose_foreground"
ZSH_HIGHLIGHT_STYLES[unknown-token]="fg=$rose_love,bold"
ZSH_HIGHLIGHT_STYLES[reserved-word]="fg=$rose_iris"
ZSH_HIGHLIGHT_STYLES[alias]="fg=$rose_rose"
ZSH_HIGHLIGHT_STYLES[builtin]="fg=$rose_rose"
ZSH_HIGHLIGHT_STYLES[function]="fg=$rose_rose"
ZSH_HIGHLIGHT_STYLES[command]="fg=$rose_foam"
ZSH_HIGHLIGHT_STYLES[precommand]="fg=$rose_foam,underline"
ZSH_HIGHLIGHT_STYLES[commandseparator]="fg=$rose_muted"
ZSH_HIGHLIGHT_STYLES[hashed-command]="fg=$rose_foam"

ZSH_HIGHLIGHT_STYLES[single-quoted-argument]="fg=$rose_gold"
ZSH_HIGHLIGHT_STYLES[double-quoted-argument]="fg=$rose_gold"
ZSH_HIGHLIGHT_STYLES[dollar-double-quoted-argument]="fg=$rose_pine"
ZSH_HIGHLIGHT_STYLES[back-quoted-argument]="fg=$rose_rose"
ZSH_HIGHLIGHT_STYLES[command-substitution]="fg=$rose_rose"
ZSH_HIGHLIGHT_STYLES[command-substitution-delimiter]="fg=$rose_muted"
ZSH_HIGHLIGHT_STYLES[process-substitution]="fg=$rose_rose"

ZSH_HIGHLIGHT_STYLES[single-hyphen-option]="fg=$rose_pine"
ZSH_HIGHLIGHT_STYLES[double-hyphen-option]="fg=$rose_pine"
ZSH_HIGHLIGHT_STYLES[path]="fg=$rose_iris,underline"
ZSH_HIGHLIGHT_STYLES[globbing]="fg=$rose_gold"
ZSH_HIGHLIGHT_STYLES[history-expansion]="fg=$rose_gold"

ZSH_HIGHLIGHT_STYLES[bracket-level-1]="fg=$rose_rose"
ZSH_HIGHLIGHT_STYLES[bracket-level-2]="fg=$rose_foam"
ZSH_HIGHLIGHT_STYLES[bracket-level-3]="fg=$rose_pine"
